# Dependencies and build output for the isolated Vercel review target.
/node_modules
/.next
/next-env.d.ts
/tsconfig.tsbuildinfo

# src/shared IS committed: the Vercel deployment is uploaded as this directory alone, so the
# vendored console sources must already be present at build time. They are generated by
# scripts/sync-shared.mjs from the repository root and cannot drift: `npm run sync:check`
# (part of the root `npm run check` and the CI job) fails if any copy differs from its source.

.vercel
.env*