{
  "name": "kidycode-admin-preview",
  "version": "0.1.0",
  "private": true,
  "description": "Vercel-hosted, access-controlled owner review target for the KidyCode admin console. Read-only, synthetic content, no database, no learner records.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "sync": "node scripts/sync-shared.mjs",
    "sync:check": "node scripts/sync-shared.mjs --check",
    "prebuild": "node scripts/sync-shared.mjs",
    "build": "next build",
    "dev": "node scripts/sync-shared.mjs && next dev --port 3011",
    "start": "next start",
    "test": "node tests/preview.test.mjs"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3"
  }
}
